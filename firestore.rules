rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{settingId} {
      allow read, write: if false;
    }

    match /profiles/{profileId} {
      allow read, write: if true;
    }

    match /people/{personId} {
      allow read, write: if true;
    }
  }
}
